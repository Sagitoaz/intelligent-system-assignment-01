# FastAPI / browser clients
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_REQUEST_BYTES=1048576

# Neo4j local Docker credentials — change these local example values together.
NEO4J_ENABLED=true
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=assignment-local-change-me
