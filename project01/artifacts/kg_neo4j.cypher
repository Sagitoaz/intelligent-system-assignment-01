// Đồ thị tri thức tiểu đường cho Neo4j. Chạy: cypher-shell -f kg_neo4j.cypher
MATCH (n:KBNode) DETACH DELETE n;
CREATE CONSTRAINT kb_id IF NOT EXISTS FOR (n:KBNode) REQUIRE n.id IS UNIQUE;
CREATE (:KBNode {id:'diabetes', label:'Diabetes', vi:'Bệnh tiểu đường', type:'condition', desc:'Bệnh xảy ra khi đường huyết (glucose) trong máu quá cao vì cơ thể thiếu hoặc không dùng tốt insulin.'});
CREATE (:KBNode {id:'type1', label:'Type 1 diabetes', vi:'Tiểu đường típ 1', type:'condition', desc:'Hệ miễn dịch phá hủy tế bào beta của tụy nên cơ thể gần như không tạo insulin; hay gặp ở trẻ em và người trẻ.'});
CREATE (:KBNode {id:'type2', label:'Type 2 diabetes', vi:'Tiểu đường típ 2', type:'condition', desc:'Dạng phổ biến nhất (khoảng 90–95% ca): tế bào kháng insulin, tụy sản xuất không đủ; tiến triển chậm qua nhiều năm.'});
CREATE (:KBNode {id:'prediabetes', label:'Prediabetes', vi:'Tiền tiểu đường', type:'condition', desc:'Đường huyết cao hơn bình thường nhưng chưa đủ để chẩn đoán tiểu đường típ 2; còn cơ hội đảo ngược nếu thay đổi lối sống.'});
CREATE (:KBNode {id:'gestational', label:'Gestational diabetes', vi:'Tiểu đường thai kỳ', type:'condition', desc:'Xuất hiện khi mang thai, thường hết sau sinh nhưng làm tăng nguy cơ tiểu đường típ 2 về sau.'});
CREATE (:KBNode {id:'insulin_res', label:'Insulin resistance', vi:'Kháng insulin', type:'condition', desc:'Tế bào không đáp ứng tốt với insulin nên glucose khó vào tế bào và ở lại trong máu.'});
CREATE (:KBNode {id:'thirst', label:'Increased thirst', vi:'Khát nước nhiều', type:'symptom', desc:'Đường huyết cao kéo nước ra khỏi mô khiến người bệnh khát liên tục.'});
CREATE (:KBNode {id:'urination', label:'Frequent urination', vi:'Đi tiểu nhiều', type:'symptom', desc:'Thận đào thải bớt glucose qua nước tiểu nên phải đi tiểu thường xuyên, kể cả ban đêm.'});
CREATE (:KBNode {id:'fatigue', label:'Fatigue', vi:'Mệt mỏi', type:'symptom', desc:'Glucose không vào được tế bào để tạo năng lượng nên người bệnh mệt mỏi, uể oải.'});
CREATE (:KBNode {id:'blurred', label:'Blurred vision', vi:'Nhìn mờ', type:'symptom', desc:'Đường huyết cao làm thay đổi hình dạng thấu kính mắt nên nhìn mờ.'});
CREATE (:KBNode {id:'slow_heal', label:'Slow-healing sores', vi:'Vết thương lâu lành', type:'symptom', desc:'Đường huyết cao làm giảm lưu thông máu và khả năng chống nhiễm trùng nên vết loét, vết cắt lâu lành.'});
CREATE (:KBNode {id:'weight_loss', label:'Unexplained weight loss', vi:'Sụt cân không rõ lý do', type:'symptom', desc:'Cơ thể đốt mỡ và cơ để lấy năng lượng khi thiếu insulin; thường gặp ở típ 1.'});
CREATE (:KBNode {id:'dka', label:'Diabetic ketoacidosis', vi:'Nhiễm toan ceton', type:'complication', desc:'Biến chứng cấp cứu khi cơ thể thiếu insulin nặng và tích tụ ceton trong máu; cần đi cấp cứu ngay.'});
CREATE (:KBNode {id:'overweight', label:'Overweight / obesity', vi:'Thừa cân, béo phì', type:'risk_factor', desc:'Mỡ thừa, nhất là mỡ bụng, làm tăng kháng insulin; là yếu tố nguy cơ chính có thể thay đổi được.'});
CREATE (:KBNode {id:'inactivity', label:'Physical inactivity', vi:'Ít vận động', type:'risk_factor', desc:'Ít hoạt động thể chất làm tăng nguy cơ tiểu đường típ 2; vận động giúp hạ đường huyết, huyết áp và mỡ máu.'});
CREATE (:KBNode {id:'age', label:'Age 35 or older', vi:'Tuổi từ 35 trở lên', type:'risk_factor', desc:'Nguy cơ tiểu đường típ 2 tăng dần theo tuổi; người lớn tuổi nên được tầm soát định kỳ.'});
CREATE (:KBNode {id:'family', label:'Family history', vi:'Tiền sử gia đình', type:'risk_factor', desc:'Có cha mẹ hoặc anh chị em ruột bị tiểu đường làm tăng nguy cơ; không thay đổi được.'});
CREATE (:KBNode {id:'high_bp', label:'High blood pressure', vi:'Huyết áp cao', type:'risk_factor', desc:'Huyết áp cao thường đi cùng tiểu đường típ 2 và làm tăng nguy cơ biến chứng tim, thận.'});
CREATE (:KBNode {id:'high_chol', label:'High cholesterol', vi:'Mỡ máu cao', type:'risk_factor', desc:'HDL thấp và triglyceride cao là yếu tố nguy cơ; mỡ máu cần được kiểm soát cùng đường huyết.'});
CREATE (:KBNode {id:'smoking', label:'Smoking', vi:'Hút thuốc', type:'risk_factor', desc:'Hút thuốc làm tăng nguy cơ tiểu đường típ 2 và làm biến chứng mạch máu nặng hơn; bỏ thuốc rất có lợi.'});
CREATE (:KBNode {id:'hx_gdm', label:'History of gestational diabetes', vi:'Từng bị tiểu đường thai kỳ', type:'risk_factor', desc:'Phụ nữ từng bị tiểu đường thai kỳ hoặc sinh con trên 4 kg có nguy cơ cao hơn.'});
CREATE (:KBNode {id:'a1c', label:'A1C test', vi:'Xét nghiệm A1C', type:'test', desc:'Đo đường huyết trung bình 2–3 tháng. Theo chuẩn ADA: từ 6,5% trở lên là tiểu đường; 5,7–6,4% là tiền tiểu đường.'});
CREATE (:KBNode {id:'fpg', label:'Fasting plasma glucose', vi:'Đường huyết lúc đói (FPG)', type:'test', desc:'Đo sau nhịn ăn ít nhất 8 giờ. Theo chuẩn ADA: từ 126 mg/dL trở lên là tiểu đường; 100–125 mg/dL là tiền tiểu đường.'});
CREATE (:KBNode {id:'ogtt', label:'Oral glucose tolerance test', vi:'Nghiệm pháp dung nạp glucose (OGTT)', type:'test', desc:'Đo đường huyết sau uống dung dịch glucose 2 giờ. Theo chuẩn ADA: từ 200 mg/dL là tiểu đường; 140–199 mg/dL là tiền tiểu đường.'});
CREATE (:KBNode {id:'rpg', label:'Random plasma glucose', vi:'Đường huyết ngẫu nhiên', type:'test', desc:'Đo vào bất kỳ lúc nào khi có triệu chứng; từ 200 mg/dL kèm triệu chứng gợi ý tiểu đường.'});
CREATE (:KBNode {id:'screening', label:'Routine screening', vi:'Tầm soát định kỳ', type:'test', desc:'Người có yếu tố nguy cơ nên xét nghiệm định kỳ; kết quả bình thường vẫn nên làm lại sau mỗi 3 năm.'});
CREATE (:KBNode {id:'weight_mgmt', label:'Healthy weight', vi:'Giữ cân nặng hợp lý', type:'lifestyle', desc:'Giảm một phần cân nặng giúp giảm kháng insulin; hỏi nhóm chăm sóc sức khỏe về kế hoạch phù hợp.'});
CREATE (:KBNode {id:'activity', label:'Physical activity', vi:'Vận động đều đặn', type:'lifestyle', desc:'Nên ít nhất 150 phút mỗi tuần hoạt động cường độ vừa như đi bộ nhanh; có thể thêm bài tập sức mạnh.'});
CREATE (:KBNode {id:'healthy_eating', label:'Healthy eating', vi:'Ăn uống lành mạnh', type:'lifestyle', desc:'Ưu tiên rau, trái cây, ngũ cốc nguyên hạt, đạm nạc; hạn chế đồ uống có đường và thức ăn nhiều đường tinh luyện.'});
CREATE (:KBNode {id:'quit_smoking', label:'Quitting smoking', vi:'Bỏ thuốc lá', type:'lifestyle', desc:'Bỏ thuốc giúp giảm nguy cơ biến chứng tim mạch và cải thiện kiểm soát đường huyết.'});
CREATE (:KBNode {id:'glucose_monitor', label:'Blood glucose monitoring', vi:'Tự theo dõi đường huyết', type:'treatment', desc:'Đo đường huyết tại nhà (hoặc máy theo dõi liên tục CGM) giúp tránh đường huyết quá cao hoặc quá thấp.'});
CREATE (:KBNode {id:'time_in_range', label:'Time in range', vi:'Thời gian trong ngưỡng an toàn', type:'treatment', desc:'Phần trăm thời gian đường huyết nằm trong khoảng mục tiêu; là chỉ số dùng trong demo huấn luyện viên RL.'});
CREATE (:KBNode {id:'medicines', label:'Diabetes medicines', vi:'Thuốc điều trị tiểu đường', type:'treatment', desc:'Gồm thuốc uống và thuốc tiêm do bác sĩ chỉ định; không tự ý dùng hoặc ngừng.'});
CREATE (:KBNode {id:'insulin_tx', label:'Insulin therapy', vi:'Điều trị bằng insulin', type:'treatment', desc:'Bắt buộc với típ 1 và một số người típ 2; liều do bác sĩ quyết định.'});
CREATE (:KBNode {id:'hypo', label:'Hypoglycemia', vi:'Hạ đường huyết', type:'complication', desc:'Đường huyết dưới 70 mg/dL ở người bệnh tiểu đường: run, đói, vã mồ hôi; cần ăn nhanh đường hấp thu nhanh và báo bác sĩ.'});
CREATE (:KBNode {id:'hyper', label:'Hyperglycemia', vi:'Tăng đường huyết', type:'complication', desc:'Đường huyết cao kéo dài gây khát, tiểu nhiều và tổn thương mạch máu, thần kinh về lâu dài.'});
CREATE (:KBNode {id:'heart', label:'Heart disease', vi:'Bệnh tim mạch', type:'complication', desc:'Tiểu đường làm tăng nguy cơ nhồi máu cơ tim và đột quỵ.'});
CREATE (:KBNode {id:'kidney', label:'Kidney disease', vi:'Bệnh thận', type:'complication', desc:'Đường huyết cao lâu ngày làm tổn thương các mạch máu nhỏ ở thận.'});
CREATE (:KBNode {id:'eye', label:'Eye damage', vi:'Tổn thương mắt', type:'complication', desc:'Có thể dẫn đến bệnh võng mạc đái tháo đường và mù lòa nếu không kiểm soát và khám mắt định kỳ.'});
CREATE (:KBNode {id:'nerve', label:'Nerve damage', vi:'Tổn thương thần kinh', type:'complication', desc:'Gây tê, ngứa ran hoặc đau ở bàn chân, bàn tay; làm tăng nguy cơ loét chân.'});
CREATE (:KBNode {id:'foot', label:'Foot problems', vi:'Biến chứng bàn chân', type:'complication', desc:'Giảm cảm giác và lưu thông máu dễ gây loét, nhiễm trùng; cần kiểm tra chân hằng ngày.'});
MATCH (a:KBNode {id:'type1'}), (b:KBNode {id:'diabetes'}) CREATE (a)-[:IS_A]->(b);
MATCH (a:KBNode {id:'type2'}), (b:KBNode {id:'diabetes'}) CREATE (a)-[:IS_A]->(b);
MATCH (a:KBNode {id:'gestational'}), (b:KBNode {id:'diabetes'}) CREATE (a)-[:IS_A]->(b);
MATCH (a:KBNode {id:'prediabetes'}), (b:KBNode {id:'type2'}) CREATE (a)-[:RAISES_RISK]->(b);
MATCH (a:KBNode {id:'insulin_res'}), (b:KBNode {id:'type2'}) CREATE (a)-[:CAUSES]->(b);
MATCH (a:KBNode {id:'overweight'}), (b:KBNode {id:'insulin_res'}) CREATE (a)-[:CAUSES]->(b);
MATCH (a:KBNode {id:'thirst'}), (b:KBNode {id:'diabetes'}) CREATE (a)-[:SYMPTOM_OF]->(b);
MATCH (a:KBNode {id:'urination'}), (b:KBNode {id:'diabetes'}) CREATE (a)-[:SYMPTOM_OF]->(b);
MATCH (a:KBNode {id:'fatigue'}), (b:KBNode {id:'diabetes'}) CREATE (a)-[:SYMPTOM_OF]->(b);
MATCH (a:KBNode {id:'blurred'}), (b:KBNode {id:'diabetes'}) CREATE (a)-[:SYMPTOM_OF]->(b);
MATCH (a:KBNode {id:'slow_heal'}), (b:KBNode {id:'diabetes'}) CREATE (a)-[:SYMPTOM_OF]->(b);
MATCH (a:KBNode {id:'weight_loss'}), (b:KBNode {id:'type1'}) CREATE (a)-[:SYMPTOM_OF]->(b);
MATCH (a:KBNode {id:'dka'}), (b:KBNode {id:'type1'}) CREATE (a)-[:COMPLICATION_OF]->(b);
MATCH (a:KBNode {id:'overweight'}), (b:KBNode {id:'type2'}) CREATE (a)-[:RAISES_RISK]->(b);
MATCH (a:KBNode {id:'inactivity'}), (b:KBNode {id:'type2'}) CREATE (a)-[:RAISES_RISK]->(b);
MATCH (a:KBNode {id:'age'}), (b:KBNode {id:'type2'}) CREATE (a)-[:RAISES_RISK]->(b);
MATCH (a:KBNode {id:'family'}), (b:KBNode {id:'type2'}) CREATE (a)-[:RAISES_RISK]->(b);
MATCH (a:KBNode {id:'high_bp'}), (b:KBNode {id:'type2'}) CREATE (a)-[:RAISES_RISK]->(b);
MATCH (a:KBNode {id:'high_chol'}), (b:KBNode {id:'type2'}) CREATE (a)-[:RAISES_RISK]->(b);
MATCH (a:KBNode {id:'smoking'}), (b:KBNode {id:'type2'}) CREATE (a)-[:RAISES_RISK]->(b);
MATCH (a:KBNode {id:'hx_gdm'}), (b:KBNode {id:'type2'}) CREATE (a)-[:RAISES_RISK]->(b);
MATCH (a:KBNode {id:'diabetes'}), (b:KBNode {id:'a1c'}) CREATE (a)-[:DIAGNOSED_BY]->(b);
MATCH (a:KBNode {id:'diabetes'}), (b:KBNode {id:'fpg'}) CREATE (a)-[:DIAGNOSED_BY]->(b);
MATCH (a:KBNode {id:'diabetes'}), (b:KBNode {id:'ogtt'}) CREATE (a)-[:DIAGNOSED_BY]->(b);
MATCH (a:KBNode {id:'diabetes'}), (b:KBNode {id:'rpg'}) CREATE (a)-[:DIAGNOSED_BY]->(b);
MATCH (a:KBNode {id:'prediabetes'}), (b:KBNode {id:'a1c'}) CREATE (a)-[:DIAGNOSED_BY]->(b);
MATCH (a:KBNode {id:'prediabetes'}), (b:KBNode {id:'fpg'}) CREATE (a)-[:DIAGNOSED_BY]->(b);
MATCH (a:KBNode {id:'gestational'}), (b:KBNode {id:'ogtt'}) CREATE (a)-[:DIAGNOSED_BY]->(b);
MATCH (a:KBNode {id:'diabetes'}), (b:KBNode {id:'screening'}) CREATE (a)-[:DIAGNOSED_BY]->(b);
MATCH (a:KBNode {id:'type2'}), (b:KBNode {id:'weight_mgmt'}) CREATE (a)-[:PREVENTED_BY]->(b);
MATCH (a:KBNode {id:'type2'}), (b:KBNode {id:'activity'}) CREATE (a)-[:PREVENTED_BY]->(b);
MATCH (a:KBNode {id:'prediabetes'}), (b:KBNode {id:'healthy_eating'}) CREATE (a)-[:PREVENTED_BY]->(b);
MATCH (a:KBNode {id:'prediabetes'}), (b:KBNode {id:'activity'}) CREATE (a)-[:PREVENTED_BY]->(b);
MATCH (a:KBNode {id:'overweight'}), (b:KBNode {id:'weight_mgmt'}) CREATE (a)-[:TREATED_BY]->(b);
MATCH (a:KBNode {id:'inactivity'}), (b:KBNode {id:'activity'}) CREATE (a)-[:TREATED_BY]->(b);
MATCH (a:KBNode {id:'smoking'}), (b:KBNode {id:'quit_smoking'}) CREATE (a)-[:TREATED_BY]->(b);
MATCH (a:KBNode {id:'diabetes'}), (b:KBNode {id:'healthy_eating'}) CREATE (a)-[:TREATED_BY]->(b);
MATCH (a:KBNode {id:'diabetes'}), (b:KBNode {id:'activity'}) CREATE (a)-[:TREATED_BY]->(b);
MATCH (a:KBNode {id:'diabetes'}), (b:KBNode {id:'medicines'}) CREATE (a)-[:TREATED_BY]->(b);
MATCH (a:KBNode {id:'type1'}), (b:KBNode {id:'insulin_tx'}) CREATE (a)-[:TREATED_BY]->(b);
MATCH (a:KBNode {id:'diabetes'}), (b:KBNode {id:'glucose_monitor'}) CREATE (a)-[:MONITORS]->(b);
MATCH (a:KBNode {id:'glucose_monitor'}), (b:KBNode {id:'time_in_range'}) CREATE (a)-[:MONITORS]->(b);
MATCH (a:KBNode {id:'activity'}), (b:KBNode {id:'high_bp'}) CREATE (a)-[:HELPS]->(b);
MATCH (a:KBNode {id:'activity'}), (b:KBNode {id:'high_chol'}) CREATE (a)-[:HELPS]->(b);
MATCH (a:KBNode {id:'insulin_tx'}), (b:KBNode {id:'hypo'}) CREATE (a)-[:CAUSES]->(b);
MATCH (a:KBNode {id:'medicines'}), (b:KBNode {id:'hypo'}) CREATE (a)-[:CAUSES]->(b);
MATCH (a:KBNode {id:'diabetes'}), (b:KBNode {id:'hyper'}) CREATE (a)-[:CAUSES]->(b);
MATCH (a:KBNode {id:'diabetes'}), (b:KBNode {id:'heart'}) CREATE (a)-[:CAUSES]->(b);
MATCH (a:KBNode {id:'diabetes'}), (b:KBNode {id:'kidney'}) CREATE (a)-[:CAUSES]->(b);
MATCH (a:KBNode {id:'diabetes'}), (b:KBNode {id:'eye'}) CREATE (a)-[:CAUSES]->(b);
MATCH (a:KBNode {id:'diabetes'}), (b:KBNode {id:'nerve'}) CREATE (a)-[:CAUSES]->(b);
MATCH (a:KBNode {id:'nerve'}), (b:KBNode {id:'foot'}) CREATE (a)-[:CAUSES]->(b);
MATCH (a:KBNode {id:'heart'}), (b:KBNode {id:'high_bp'}) CREATE (a)-[:RAISES_RISK]->(b);
MATCH (a:KBNode {id:'kidney'}), (b:KBNode {id:'high_bp'}) CREATE (a)-[:RAISES_RISK]->(b);
